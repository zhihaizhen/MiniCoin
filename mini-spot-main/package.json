    "react-redux": "7.2.9",
    "react-router-dom": "5.3.4",
    "react-sizeme": "2.6.12",
    "react-toastify": "6.0.8",
    "react-use": "15.3.3",
    "redux": "4.2.1",
    "redux-thunk": "2.4.2",
    "rxjs": "6.5.5",
