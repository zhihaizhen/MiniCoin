    "@loadable/component": "5.12.0",
    "@region-lib/env": "0.1.27",
    "@region-lib/language": "0.0.72",
    "@region-lib/public-ws": "0.0.27",
    "@region/by-idb": "^0.15.19",
    "@region/by-route-finder": "^2.0.27",
    "@region/by-shared-settings": "^1.0.25",
    "@sentry/browser": "^7.108.0",
