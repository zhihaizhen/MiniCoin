{
  "name": "marvel-trade",
  "version": "1.0.1",
  "private": true,
  "description": "trade(including forward/reverse/data) and data application",
  "scripts": {
    "start": "cross-env MARVEL_APP_TITLE=EasiCoin    marvel start --business forward --platform desktop",
    "start:no-update-check": "cross-env SKIP_CLI_UPDATE_CHECK=true marvel start",
    "build:production": "cross-env BUILD_ENV=production MARVEL_APP_TITLE=EasiCoin   marvel build  --business forward  --platform desktop",
    "build:test": "cross-env BUILD_ENV=test MARVEL_APP_TITLE=EasiCoin   marvel build  --business forward  --platform desktop",
    "uploadSourceMap": " node src/.marvel/scripts/uploadSourceMap.js",
    "analyze": "marvel analyze",
    "generate": "marvel generate",
    "mock": "marvel mock",
    "nativerc": "marvel nativerc",
    "build:analyze": "cross-env BUILD_ENV=production marvel build --analyze-bundle --measure-speed",
    "build:analyze:no-lint": "cross-env BUILD_ENV=production LINT_BEFORE_BABEL=false marvel build --analyze-bundle --measure-speed",
    "lint:js": "eslint --ext .js,.jsx,.ts,.tsx src/",
    "lint:fix": "eslint --fix --ext .js,.jsx,.ts,.tsx src/",
    "lint:style": "stylelint --fix \"src/betterbitapps/**/*.less\" --syntax less",
    "prettier": "prettier -c --write \"src/betterbitapps/**/*.{js,jsx,ts,tsx,less,md,json}\"",
    "check-update": "check-update --config ./.config/check-updates.config.js --upgrade",
    "commit": "git cz",
    "log": "conventional-changelog -p conventionalcommits -c changelog.config -i CHANGELOG.md -s -r 0 -w",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org betterbit --project future-trade ./src/betterbitapps && sentry-cli sourcemaps upload --org betterbit --project future-trade ./app/forward/desktop"
  },
  "dependencies": {
    "@babel/helper-string-parser": "7.23.4",
