    "betterbit-frame-pkg": "^1.0.1",
    "betterbit-ui": "1.2.27",
    "bignumber.js": "9.1.1",
    "by-i18n-backend": "0.15.8",
    "by-i18n-language-detect": "0.15.8",
    "by-storage": "0.15.11",
    "by-ws": "1.6.3",
