{
  "$schema": "http://json-schema.org/schema",
  "cli": "nx",
  "$id": "AppGenerator",
  "title": "",
  "type": "object",
  "properties": {
    "scenario": {
      "type": "string",
      "default": "nextjs",
      "x-prompt": {
        "message": "Please choose the scenario going to apply:",
        "type": "list",
        "items": [
          {
            "label": "SSR - NEXTJS",
            "value": "nextjs"
          },
          {
            "label": "CSR - REACT SPA",
            "value": "react"
          }
        ]
      }
    },
    "name": {
      "type": "string",
      "description": "",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use?"
    },
    "headerFooter": {
      "type": "boolean",
      "description": "headerFooter",
      "default": true,
      "x-prompt": {
        "message": "Is project required header and footer?",
        "type": "confirmation"
      }
    },
    "i18n": {
      "type": "boolean",
      "description": "i18n",
      "default": true,
      "x-prompt": {
        "message": "Is project required i18n support?",
        "type": "confirmation"
      }
    },
    "defaultLang": {
      "type": "string",
      "description": "Default language",
      "default": "en-US",
      "x-prompt": {
        "message": "Default language for the page?",
        "type": "list",
        "items": [
          {
            "value": "en-US",
            "label": "en-US English"
          },
          {
            "value": "zh-TW",
            "label": "zh-TW 中文繁體"
          },
          {
            "value": "ko-KR",
            "label": "ko-KR 한국어"
          },
          {
            "value": "tr-TR",
            "label": "tr-TR Türkçe"
          },
          {
            "value": "id-ID",
            "label": "id-ID Indonesia"
          },
          {
            "value": "ru-RU",
            "label": "ru-RU Русский"
          },
          {
            "value": "es-ES",
            "label": "es-ES Español"
          },
          {
            "value": "pt-PT",
            "label": "pt-PT Português"
          },
          {
            "value": "ar-SA",
            "label": "ar-SA العربية"
          }
        ]
      }
    }
  },
  "required": [
    "scenario",
    "name"
  ]
}