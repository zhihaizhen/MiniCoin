{
  "root": "apps/<%= projectName %>",
  "sourceRoot": "apps/<%= projectName %>",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "root": "apps/<%= projectName %>",
        "outputPath": "dist/apps/<%= projectName %>"
      },
      "configurations": {
        "production": {},
        "testnet": {
          "outputPath": "dist/testnet/apps/<%= projectName %>"
        },
        "test": {
          "outputPath": "dist/test/apps/<%= projectName %>"
        },
        "dev": {
          "outputPath": "dist/dev/apps/<%= projectName %>"
        }
      }
    },
    "serve": {
      "executor": "@nrwl/next:server",
      "options": {
        "buildTarget": "<%= projectName %>:build",
        "dev": true,
        "hostname": "dev.test.bitrunfinance.com",
        "port": 4200
      },
      "configurations": {
        "dev": {
          "buildTarget": "<%= projectName %>:build:development",
          "dev": true
        },
        "test": {
          "buildTarget": "<%= projectName %>:build:development",
          "dev": false
        },
        "testnet": {
          "buildTarget": "<%= projectName %>:build:production",
          "dev": false
        },
        "production": {
          "buildTarget": "<%= projectName %>:build:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nrwl/next:export",
      "options": {
        "buildTarget": "<%= projectName %>:build:production"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": [
        "coverage/apps/<%= projectName %>"
      ],
      "options": {
        "jestConfig": "apps/<%= projectName %>/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/<%= projectName %>/**/*.{ts,tsx,js,jsx}"
        ]
      }
    },
    "cexport": {
      "builder": "@nrwl/workspace:run-commands",
      "options": {
        "commands": [
          {
            "command": "node .script/custom-export.js",
            "forwardAllArgs": true
          }
        ],
        "cwd": "apps/<%= projectName %>",
        "outputPath": "dist/apps/"
      }
    }
  },
  "tags": []
}