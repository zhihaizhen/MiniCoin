{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "typeRoots": ["./types"],
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2017", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "jsx": "preserve",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@better-bit-fe/app-bridge": ["libs/app-bridge/src/index.ts"],
      "@better-bit-fe/app-generator": ["libs/app-generator/src/index.ts"],
      "@better-bit-fe/base-hooks": ["libs/base-hooks/src/index.ts"],
      "@better-bit-fe/base-provider": ["libs/base-provider/src/index.ts"],
      "@better-bit-fe/base-ui": ["libs/base-ui/src/index.ts"],
      "@better-bit-fe/base-utils": ["libs/base-utils/src/index.ts"],
      "@better-bit-fe/builder-layout": ["libs/builder-layout/src/index.ts"],
      "@better-bit-fe/global-widget": ["libs/global-widget/src/index.ts"],
      "@better-bit-fe/gray-release": ["libs/gray-release/src/index.ts"],
      "@better-bit-fe/lang": ["libs/lang/src/index.ts"],
      "@better-bit-fe/tracking": ["libs/tracking/src/index.ts"],
      "@better-bit-fe/ws-service": ["libs/ws-service/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "tmp"],
  "include": ["./libs/**/*.ts", "./libs/**/*.tsx", "./types/*.ts"]
}
