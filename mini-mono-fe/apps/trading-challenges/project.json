{
  "root": "apps/trading-challenges",
  "sourceRoot": "apps/trading-challenges",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "outputs": [
        "{options.outputPath}"
      ],
      "defaultConfiguration": "production",
      "options": {
        "root": "apps/trading-challenges",
        "outputPath": "dist/apps/trading-challenges"
      },
      "configurations": {
        "production": {},
        "testnet": {
          "outputPath": "dist/testnet/apps/trading-challenges"
        },
        "test": {
          "outputPath": "dist/test/apps/trading-challenges"
        },
        "dev": {
          "outputPath": "dist/dev/apps/trading-challenges"
        }
      }
    },
    "serve": {
      "executor": "@nrwl/next:server",
      "options": {
        "buildTarget": "trading-challenges:build",
        "dev": true,
        "hostname": "dev.test.bitrunfinance.com",
        "port": 4200
      },
      "configurations": {
        "dev": {
          "buildTarget": "trading-challenges:build:development",
          "dev": true
        },
        "test": {
          "buildTarget": "trading-challenges:build:development",
          "dev": false
        },
        "testnet": {
          "buildTarget": "trading-challenges:build:production",
          "dev": false
        },
        "production": {
          "buildTarget": "trading-challenges:build:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nrwl/next:export",
      "options": {
        "buildTarget": "trading-challenges:build:production"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": [
        "coverage/apps/trading-challenges"
      ],
      "options": {
        "jestConfig": "apps/trading-challenges/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": [
        "{options.outputFile}"
      ],
      "options": {
        "lintFilePatterns": [
          "apps/trading-challenges/**/*.{ts,tsx,js,jsx}"
        ]
      }
    },
    "cexport": {
      "builder": "@nrwl/workspace:run-commands",
      "options": {
        "commands": [
          {
            "command": "node .script/custom-export.js",
            "forwardAllArgs": true
          }
        ],
        "cwd": "apps/trading-challenges",
        "outputPath": "dist/apps/"
      }
    }
  },
  "tags": []
}