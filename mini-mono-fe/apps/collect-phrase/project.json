{
  "root": "apps/collect-phrase",
  "sourceRoot": "apps/collect-phrase",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "root": "apps/collect-phrase",
        "outputPath": "dist/apps/collect-phrase"
      },
      "configurations": {
        "production": {},
        "testnet": {
          "outputPath": "dist/testnet/apps/collect-phrase"
        },
        "test": {
          "outputPath": "dist/test/apps/collect-phrase"
        },
        "dev": {
          "outputPath": "dist/dev/apps/collect-phrase"
        }
      }
    },
    "serve": {
      "executor": "@nrwl/next:server",
      "options": {
        "buildTarget": "collect-phrase:build",
        "dev": true,
        "hostname": "dev.test.bitrunfinance.com",
        "port": 4200
      },
      "configurations": {
        "dev": {
          "buildTarget": "collect-phrase:build:development",
          "dev": true
        },
        "test": {
          "buildTarget": "collect-phrase:build:development",
          "dev": false
        },
        "testnet": {
          "buildTarget": "collect-phrase:build:production",
          "dev": false
        },
        "production": {
          "buildTarget": "collect-phrase:build:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nrwl/next:export",
      "options": {
        "buildTarget": "collect-phrase:build:production"
      }
    },
    "image-optimizer": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run image-optimizer",
        "cwd": "apps/collect-phrase"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/apps/collect-phrase"],
      "options": {
        "jestConfig": "apps/collect-phrase/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/collect-phrase/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "cexport": {
      "builder": "@nrwl/workspace:run-commands",
      "options": {
        "commands": [
          {
            "command": "node .script/custom-export.js",
            "forwardAllArgs": true
          }
        ],
        "cwd": "apps/collect-phrase",
        "outputPath": "dist/apps/"
      }
    }
  },
  "tags": []
}
