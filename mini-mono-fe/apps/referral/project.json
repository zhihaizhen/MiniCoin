{
  "root": "apps/referral",
  "sourceRoot": "apps/referral",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "@nrwl/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "root": "apps/referral",
        "outputPath": "dist/apps/referral"
      },
      "configurations": {
        "production": {},
        "testnet": {
          "outputPath": "dist/testnet/apps/referral"
        },
        "test": {
          "outputPath": "dist/test/apps/referral"
        },
        "dev": {
          "outputPath": "dist/dev/apps/referral"
        }
      }
    },
    "serve": {
      "executor": "@nrwl/next:server",
      "options": {
        "buildTarget": "referral:build",
        "dev": true,
        "hostname": "dev.test.bitrunfinance.com",
        "port": 4200
      },
      "configurations": {
        "dev": {
          "buildTarget": "referral:build:development",
          "dev": true
        },
        "test": {
          "buildTarget": "referral:build:development",
          "dev": false
        },
        "testnet": {
          "buildTarget": "referral:build:production",
          "dev": false
        },
        "production": {
          "buildTarget": "referral:build:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nrwl/next:export",
      "options": {
        "buildTarget": "referral:build:production"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/apps/referral"],
      "options": {
        "jestConfig": "apps/referral/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/referral/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "cexport": {
      "builder": "@nrwl/workspace:run-commands",
      "options": {
        "commands": [
          {
            "command": "node .script/custom-export.js",
            "forwardAllArgs": true
          }
        ],
        "cwd": "apps/referral",
        "outputPath": "dist/apps/"
      }
    }
  },
  "tags": []
}
