{
  "root": "apps/academy",
  "sourceRoot": "apps/academy",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "production",
      "dependsOn": ["compile"],
      "options": {
        "command": "node apps/academy/.script/assemble-standalone.js"
      },
      "configurations": {
        "production": {
          "command": "node apps/academy/.script/assemble-standalone.js production"
        },
        "testnet": {
          "command": "node apps/academy/.script/assemble-standalone.js testnet"
        },
        "test": {
          "command": "node apps/academy/.script/assemble-standalone.js test"
        },
        "dev": {
          "command": "node apps/academy/.script/assemble-standalone.js dev"
        }
      }
    },
    "compile": {
      "executor": "@nrwl/next:build",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "root": "apps/academy",
        "outputPath": "dist/apps/academy"
      },
      "configurations": {
        "production": {},
        "testnet": {
          "outputPath": "dist/testnet/apps/academy"
        },
        "test": {
          "outputPath": "dist/test/apps/academy"
        },
        "dev": {
          "outputPath": "dist/dev/apps/academy"
        }
      }
    },
    "serve": {
      "executor": "@nrwl/next:server",
      "options": {
        "buildTarget": "academy:compile",
        "dev": true,
        "hostname": "dev.test.bitrunfinance.com",
        "port": 4200
      },
      "configurations": {
        "dev": {
          "buildTarget": "academy:compile:development",
          "dev": true
        },
        "test": {
          "buildTarget": "academy:compile:development",
          "dev": false
        },
        "testnet": {
          "buildTarget": "academy:compile:production",
          "dev": false
        },
        "production": {
          "buildTarget": "academy:compile:production",
          "dev": false
        }
      }
    },
    "export": {
      "executor": "@nrwl/next:export",
      "options": {
        "buildTarget": "academy:compile:production"
      }
    },
    "test": {
      "executor": "@nrwl/jest:jest",
      "outputs": ["coverage/apps/academy"],
      "options": {
        "jestConfig": "apps/academy/jest.config.js",
        "passWithNoTests": true
      }
    },
    "lint": {
      "executor": "@nrwl/linter:eslint",
      "outputs": ["{options.outputFile}"],
      "options": {
        "lintFilePatterns": ["apps/academy/**/*.{ts,tsx,js,jsx}"]
      }
    },
    "cexport": {
      "builder": "@nrwl/workspace:run-commands",
      "options": {
        "commands": [
          {
            "command": "node .script/custom-export.js",
            "forwardAllArgs": true
          }
        ],
        "cwd": "apps/academy",
        "outputPath": "dist/apps/"
      }
    },
    "start": {
      "builder": "@nrwl/workspace:run-commands",
      "options": {
        "commands": [
          {
            "command": "node dist/apps/academy/.next/standalone/apps/academy/server.js"
          }
        ]
      }
    }
  },
  "tags": []
}
