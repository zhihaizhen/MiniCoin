{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "paths": {
      "~/*": ["apps/tradfi-overview/*"],
      "@better-bit-fe/gray-release": ["libs/gray-release/src/index.ts"],
      "@better-bit-fe/lang": ["libs/lang/src/index.ts"],
      "@better-bit-fe/app-bridge": ["libs/app-bridge/src/index.ts"],
      "@better-bit-fe/base-ui": ["libs/base-ui/src/index.ts"],
      "@better-bit-fe/base-hooks": ["libs/base-hooks/src/index.ts"],
      "@better-bit-fe/base-provider": ["libs/base-provider/src/index.ts"],
      "@better-bit-fe/base-utils": ["libs/base-utils/src/index.ts"],
      "@better-bit-fe/global-widget": ["libs/global-widget/src/index.ts"]
    }
  },
  "files": [],
  "include": ["**/*.ts", "**/*.tsx", "next-env.d.ts"],
  "exclude": ["node_modules"]
}
